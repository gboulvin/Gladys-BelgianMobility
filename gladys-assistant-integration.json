{
  "manifest_version": 1,
  "type": "device",
  "name": "Belgian Mobility",
  "description": {
    "en": "Live departures, delays and disruptions of Belgian public transport: SNCB, STIB, De Lijn, TEC.",
    "fr": "Départs en direct, retards et perturbations : SNCB, STIB, De Lijn et TEC dans toute la Belgique.",
    "de": "Abfahrten, Verspätungen und Störungen des ÖPNV in Belgien: SNCB, STIB, De Lijn, TEC.",
    "es": "Salidas, retrasos e incidencias del transporte público belga: SNCB, STIB, De Lijn, TEC."
  },
  "version": "0.0.0",
  "docker_image": "ghcr.io/gboulvin/gladys-belgianmobility:0.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/gboulvin/Gladys-BelgianMobility/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Follow the train stations and the metro, tram and bus stops you use, anywhere in Belgium. Data comes from two free open APIs, no account nor key needed: iRail for the SNCB trains, Transitous for STIB, De Lijn and TEC. Use the \"Search a stop\" button below to find the identifier of a stop.",
        "fr": "Suivez les gares et les arrêts de métro, tram et bus que vous utilisez, partout en Belgique. Les données viennent de deux API ouvertes et gratuites, sans compte ni clé : iRail pour les trains SNCB, Transitous pour la STIB, De Lijn et le TEC. Le bouton « Rechercher un arrêt » ci-dessous donne l'identifiant d'un arrêt.",
        "de": "Folgen Sie den Bahnhöfen sowie den U-Bahn-, Tram- und Bushaltestellen, die Sie nutzen, überall in Belgien. Die Daten stammen aus zwei freien, offenen Schnittstellen ohne Konto oder Schlüssel: iRail für die SNCB-Züge, Transitous für STIB, De Lijn und TEC. Mit „Haltestelle suchen“ unten finden Sie die Kennung einer Haltestelle.",
        "es": "Siga las estaciones de tren y las paradas de metro, tranvía y autobús que utiliza, en toda Bélgica. Los datos proceden de dos API abiertas y gratuitas, sin cuenta ni clave: iRail para los trenes de la SNCB y Transitous para STIB, De Lijn y TEC. El botón «Buscar una parada» de abajo le da el identificador de una parada."
      },
      "links": [
        {
          "url": "https://docs.irail.be",
          "label": {
            "en": "iRail API (SNCB)",
            "fr": "API iRail (SNCB)",
            "de": "iRail-API (SNCB)",
            "es": "API iRail (SNCB)"
          }
        },
        {
          "url": "https://transitous.org",
          "label": {
            "en": "Transitous (STIB, De Lijn, TEC)",
            "fr": "Transitous (STIB, De Lijn, TEC)",
            "de": "Transitous (STIB, De Lijn, TEC)",
            "es": "Transitous (STIB, De Lijn, TEC)"
          }
        }
      ]
    },
    {
      "key": "stops",
      "type": "string",
      "label": {
        "en": "Stops to follow",
        "fr": "Arrêts à suivre",
        "de": "Haltestellen",
        "es": "Paradas a seguir"
      },
      "description": {
        "en": "Separated by \";\". An SNCB station name (Namur) or a stop identifier from \"Search a stop\" (be-stib_6). Add \"| 71, 89\" to keep only some lines.",
        "fr": "Séparés par « ; ». Un nom de gare SNCB (Namur) ou un identifiant donné par « Rechercher un arrêt » (be-stib_6). Ajoutez « | 71, 89 » pour ne garder que certaines lignes.",
        "de": "Getrennt durch „;“. Ein SNCB-Bahnhof (Namur) oder eine Kennung aus „Haltestelle suchen“ (be-stib_6). „| 71, 89“ behält nur einige Linien.",
        "es": "Separadas por «;». Un nombre de estación SNCB (Namur) o un identificador de «Buscar una parada» (be-stib_6). Añada «| 71, 89» para conservar solo algunas líneas."
      },
      "placeholder": {
        "en": "e.g. Namur; be-stib_6 | 1, 5",
        "fr": "ex. Namur; be-stib_6 | 1, 5",
        "de": "z. B. Namur; be-stib_6 | 1, 5",
        "es": "p. ej. Namur; be-stib_6 | 1, 5"
      },
      "required": false
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Language of the summaries, scene outputs, SNCB station names and disruptions.",
        "fr": "Langue des résumés, des sorties de scène, des noms de gares SNCB et des perturbations.",
        "de": "Sprache der Zusammenfassungen, Szenen-Ausgaben, SNCB-Bahnhofsnamen und Störungen.",
        "es": "Idioma de los resúmenes, salidas de escena, nombres de estaciones SNCB e incidencias."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "delay_threshold",
      "type": "number",
      "label": {
        "en": "Delay alert (minutes)",
        "fr": "Alerte de retard (minutes)",
        "de": "Verspätungsalarm (Minuten)",
        "es": "Alerta de retraso (minutos)"
      },
      "description": {
        "en": "A departure late by at least this many minutes fires the \"Departure delayed\" scene trigger.",
        "fr": "Un départ en retard d'au moins ce nombre de minutes déclenche « Départ en retard » dans les scènes.",
        "de": "Eine Abfahrt mit mindestens so vielen Minuten Verspätung löst „Abfahrt verspätet“ in Szenen aus.",
        "es": "Una salida con al menos estos minutos de retraso activa «Salida con retraso» en las escenas."
      },
      "required": false,
      "default": 5,
      "min": 1,
      "max": 120
    },
    {
      "key": "imminent_minutes",
      "type": "number",
      "label": {
        "en": "Time to leave (minutes)",
        "fr": "Temps pour partir (minutes)",
        "de": "Zeit zum Aufbruch (Minuten)",
        "es": "Tiempo para salir (minutos)"
      },
      "description": {
        "en": "\"Departure soon\" fires when a departure is this many minutes away (time to walk to the stop). 0 turns it off.",
        "fr": "« Départ imminent » se déclenche quand un départ est à ce nombre de minutes (le temps de rejoindre l'arrêt). 0 le désactive.",
        "de": "„Abfahrt in Kürze“ wird ausgelöst, wenn eine Abfahrt so viele Minuten entfernt ist (Weg zur Haltestelle). 0 schaltet es ab.",
        "es": "«Salida inminente» se activa cuando falta este número de minutos para una salida (tiempo para llegar a la parada). 0 lo desactiva."
      },
      "required": false,
      "default": 10,
      "min": 0,
      "max": 120
    },
    {
      "key": "monitor_network",
      "type": "boolean",
      "label": {
        "en": "Follow the SNCB network disruptions",
        "fr": "Suivre les perturbations du réseau SNCB",
        "de": "Störungen im SNCB-Netz verfolgen",
        "es": "Seguir las incidencias de la red SNCB"
      },
      "description": {
        "en": "Adds an \"SNCB network\" device and the \"New disruption\" scene trigger.",
        "fr": "Ajoute un appareil « Réseau SNCB » et le déclencheur de scène « Nouvelle perturbation ».",
        "de": "Fügt ein Gerät „SNCB-Netz“ und den Szenen-Auslöser „Neue Störung“ hinzu.",
        "es": "Añade un dispositivo «Red SNCB» y el disparador de escena «Nueva incidencia»."
      },
      "required": false,
      "default": true
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)",
        "de": "Aktualisierungsintervall (s)",
        "es": "Intervalo de actualización (s)"
      },
      "description": {
        "en": "How often each stop is read, in seconds (one minute minimum).",
        "fr": "Fréquence de lecture de chaque arrêt, en secondes (une minute minimum).",
        "de": "Wie oft jede Haltestelle gelesen wird, in Sekunden (mindestens eine Minute).",
        "es": "Frecuencia de lectura de cada parada, en segundos (mínimo un minuto)."
      },
      "required": false,
      "default": 60,
      "min": 60,
      "max": 3600
    }
  ],
  "actions": [
    {
      "key": "search_stop",
      "label": {
        "en": "Search a stop",
        "fr": "Rechercher un arrêt",
        "de": "Haltestelle suchen",
        "es": "Buscar una parada"
      },
      "description": {
        "en": "Find the identifier of a metro, tram, bus or train stop to paste in \"Stops to follow\".",
        "fr": "Trouve l'identifiant d'un arrêt de métro, tram, bus ou train à coller dans « Arrêts à suivre ».",
        "de": "Findet die Kennung einer U-Bahn-, Tram-, Bus- oder Zughaltestelle für „Haltestellen“.",
        "es": "Encuentra el identificador de una parada de metro, tranvía, autobús o tren para «Paradas a seguir»."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "query",
          "type": "string",
          "label": {
            "en": "Stop name",
            "fr": "Nom de l'arrêt",
            "de": "Name der Haltestelle",
            "es": "Nombre de la parada"
          },
          "placeholder": {
            "en": "e.g. De Brouckère",
            "fr": "ex. De Brouckère",
            "de": "z. B. De Brouckère",
            "es": "p. ej. De Brouckère"
          },
          "required": true
        }
      ]
    },
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 30
    }
  ],
